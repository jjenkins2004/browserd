#!/bin/sh
# Start the browser MCP server in the background; each profile's Chrome starts on its first use. Works from any directory.
# Git Bash on Windows too, with Windows' own Python (py -3): its python3 may be MSYS2's. BROWSERD_PYTHON picks another.
cd "$(dirname "$0")" || exit 1
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) PY=${BROWSERD_PYTHON:-py -3} ;; *) PY=${BROWSERD_PYTHON:-python3} ;; esac
exec $PY -m browser.service start "$@"
